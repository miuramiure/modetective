[Unit]
Description=modetective server
After=network-online.target
Wants=network-online.target

[Service]
User=mdt
Group=mdt
WorkingDirectory=/opt/modetective/current
EnvironmentFile=/etc/modetective/env
Environment=NODE_ENV=production
Environment=MDT_CARDS_DIR=/opt/modetective/current/data/cards
# MemoryMax より手前で GC が働くよう、V8 のヒープを抑える
ExecStart=/usr/bin/node --max-old-space-size=128 /opt/modetective/current/dist/index.js
Restart=always
RestartSec=3
MemoryMax=200M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/modetective

[Install]
WantedBy=multi-user.target
