# modetective.m-miura.jp（ConoHa WING）。画面は index.html 1枚（?r= ／ ?gm= で切り替える）
Options -Indexes

<IfModule mod_headers.c>
  # ハッシュ付きのファイル（assets/）は1年キャッシュ
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html はキャッシュしない（新しい版をすぐ反映）
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
